# Webflow API connection — template. Copy to .env and fill in real values.
#   cp .env.example .env

# Site ID for the target Webflow site (Site settings → General, or via the Data API).
WEBFLOW_SITE_ID=your-site-id

# Webflow Site API token (Data API v2 Bearer token).
# Site settings → Apps & integrations → API access → Generate API token.
WEBFLOW_API_TOKEN=your-site-api-token
